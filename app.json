{
  "expo": {
    "name": "memory ev",
    "slug": "memory-ev",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ev",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#110E0C",
    "ios": {
      "icon": "./assets/images/memory-ev-logo.png",
      "bundleIdentifier": "com.ev.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ev.app",
      "versionCode": 3,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#110E0C",
        "foregroundImage": "./assets/images/android-icon-foreground-v2.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#110E0C",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 112
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "O memory ev usa o microfone para você gravar áudios e guardá-los no aparelho."
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "O memory ev acessa suas fotos para você guardar memórias no aparelho.",
          "cameraPermission": "O memory ev usa a câmera para você registrar memórias."
        }
      ],
      "./plugins/withGradleVersion",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O memory ev usa sua localização só para mostrar o clima de hoje."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "sinais"
        }
      ],
      "expo-web-browser",
      [
        "react-native-android-widget",
        {
          "widgets": [{
            "name": "Bilhete",
            "label": "memory ev · bilhete",
            "description": "Um carinho do seu amor na tela inicial. Prévia opcional no app.",
            "minWidth": "250dp",
            "minHeight": "110dp",
            "targetCellWidth": 4,
            "targetCellHeight": 2,
            "updatePeriodMillis": 1800000,
            "resizeMode": "horizontal|vertical"
          }]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
